{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(json|html|js|css)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(webp|png|woff2|ttf)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] },
      { "source": "**", "headers": [ { "key": "Permissions-Policy", "value": "microphone=(self)" } ] }
    ]
  }
}
